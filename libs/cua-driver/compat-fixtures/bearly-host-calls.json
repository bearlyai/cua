{
  "description": "Tool calls the Bearly desktop app and dashboard send to the driver: each row is a tool name and an arguments object carrying every key that caller can send. Values are representative. Every row must name a registered tool and contain no argument the tool's advertised schema would refuse as unknown on each listed platform.",
  "cli": [
    {
      "args": [
        "serve",
        "--embedded",
        "--host-bundle-id",
        "com.bearly.app",
        "--socket",
        "<socket>"
      ],
      "env": [
        "CUA_DRIVER_EMBEDDED=1",
        "CUA_DRIVER_HOST_BUNDLE_ID=com.bearly.app"
      ]
    },
    {
      "args": [
        "status",
        "--socket",
        "<socket>"
      ]
    },
    {
      "args": [
        "list-tools"
      ]
    },
    {
      "args": [
        "call",
        "<tool>",
        "<json>",
        "--socket",
        "<socket>"
      ]
    },
    {
      "args": [
        "--version"
      ]
    }
  ],
  "calls": [
    {
      "tool": "check_permissions",
      "caller": "desktop app: permission check before computer use",
      "platforms": [
        "macos",
        "windows"
      ],
      "args": {
        "session": "bearly",
        "prompt": false
      }
    },
    {
      "tool": "set_config",
      "caller": "desktop app: capture configuration before a call that names a capture scope",
      "platforms": [
        "macos",
        "windows"
      ],
      "args": {
        "session": "bearly-chat-01",
        "max_image_dimension": 1280
      }
    },
    {
      "tool": "start_session",
      "caller": "dashboard: start or revive a run's session",
      "platforms": [
        "macos",
        "windows"
      ],
      "args": {
        "session": "bearly-chat-01"
      }
    },
    {
      "tool": "end_session",
      "caller": "dashboard and desktop app: end a run's session",
      "platforms": [
        "macos",
        "windows"
      ],
      "args": {
        "session": "bearly-chat-01"
      }
    },
    {
      "tool": "health_report",
      "caller": "dashboard: window tools version probe",
      "platforms": [
        "macos",
        "windows"
      ],
      "args": {
        "session": "bearly",
        "include": [
          "binary_version"
        ]
      }
    },
    {
      "tool": "list_windows",
      "caller": "dashboard: list windows",
      "platforms": [
        "macos",
        "windows"
      ],
      "args": {
        "session": "bearly-chat-01"
      }
    },
    {
      "tool": "get_desktop_state",
      "caller": "use_computer: desktop screenshot",
      "platforms": [
        "macos",
        "windows"
      ],
      "args": {
        "session": "bearly-chat-01"
      }
    },
    {
      "tool": "get_window_state",
      "caller": "use_computer: inspect a window's elements",
      "platforms": [
        "macos",
        "windows"
      ],
      "args": {
        "session": "bearly-chat-01",
        "pid": 4242,
        "window_id": 1001,
        "include_screenshot": false,
        "max_elements": 500,
        "max_depth": 30
      }
    },
    {
      "tool": "get_window_state",
      "caller": "use_computer: window screenshot scale",
      "platforms": [
        "macos",
        "windows"
      ],
      "args": {
        "session": "bearly-chat-01",
        "pid": 4242,
        "window_id": 1001,
        "max_elements": 1
      }
    },
    {
      "tool": "get_window_state",
      "caller": "window tools: look at a window",
      "platforms": [
        "macos",
        "windows"
      ],
      "args": {
        "session": "bearly-chat-01",
        "pid": 4242,
        "window_id": 1001,
        "include_screenshot": true,
        "max_elements": 500
      }
    },
    {
      "tool": "move_cursor",
      "caller": "use_computer: move the pointer",
      "platforms": [
        "macos",
        "windows"
      ],
      "args": {
        "session": "bearly-chat-01",
        "x": 640,
        "y": 400
      }
    },
    {
      "tool": "click",
      "caller": "use_computer: click a desktop point",
      "platforms": [
        "macos",
        "windows"
      ],
      "args": {
        "session": "bearly-chat-01",
        "x": 640,
        "y": 400,
        "button": "left",
        "count": 1,
        "modifier": [],
